# Copy to .env.local and fill in. Values that start with NEXT_PUBLIC_ are
# written into the browser bundle at build time, so they are NOT secret —
# never put a payment or API secret key in a NEXT_PUBLIC_ variable.
# Changing any of these needs a rebuild / redeploy to take effect.

# The public address of the live site, no trailing slash. Used for the
# sitemap, canonical links and social-share previews.
NEXT_PUBLIC_SITE_URL=https://your-real-domain.com

# Google Sheet order intake. See google-apps-script/README.md.
# Leave empty to keep orders in the browser only.
NEXT_PUBLIC_ORDER_WEBHOOK=

# Contact form + newsletter. Free key from https://web3forms.com (enter your
# email, no account needed). Leave empty and the contact form falls back to
# opening WhatsApp, and the newsletter box is hidden.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Password for the /admin page (browser sign-in prompt; any username works).
# SERVER-SIDE ONLY — do not prefix with NEXT_PUBLIC_. If this is not set,
# /admin is blocked entirely in production.
ADMIN_PASSWORD=
